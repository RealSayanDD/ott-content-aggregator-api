SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_URL=sqlite+aiosqlite:///./app.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ott
ENABLE_AVAILABILITY_SCHEDULER=true
AVAILABILITY_SYNC_INTERVAL_MINUTES=60
ENABLE_MOCK_PROVIDER_SYNC=true
PROVIDER_SYNC_INTERVAL_MINUTES=60
# Keep true for a new local SQLite database. Set false in deployed environments
# and run `alembic upgrade head` before starting the API.
AUTO_CREATE_TABLES=true
